# =============================================================================
# DIGITAL EKUB PLATFORM - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and replace values with your actual credentials.
# NEVER commit the .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# DJANGO CORE SETTINGS
# -----------------------------------------------------------------------------
# Generate a new secret key using:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-7&$kq@3p!v^r!2&x%9^h7f^1!s$5%^g%^h%j!k%l%m%n%o%p%q%r

# Set to 1 for development, 0 for production
DEBUG=1

# Comma-separated list of allowed hosts/domains
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,ekub.example.com

# Comma-separated list of trusted origins for CSRF
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:5173,http://localhost:80,https://ekub.example.com

# -----------------------------------------------------------------------------
# DATABASE (POSTGRESQL)
# -----------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=ekub_db
DB_USER=ekub_user
DB_PASSWORD=strongpassword123
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=600
DB_CONN_HEALTH_CHECK_INTERVAL=60

# -----------------------------------------------------------------------------
# REDIS (CACHE & CELERY BROKER)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# CELERY CONFIGURATION
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TIMEZONE=Africa/Addis_Ababa
CELERY_ACCEPT_CONTENT=json
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_WORKER_CONCURRENCY=4
CELERY_BEAT_SCHEDULER=django_celery_beat.schedulers:DatabaseScheduler

# -----------------------------------------------------------------------------
# EMAIL (BREVO / SENDINBLUE)
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-brevo-email@example.com
EMAIL_HOST_PASSWORD=your-brevo-smtp-password
DEFAULT_FROM_EMAIL=no-reply@ekub-platform.com

# -----------------------------------------------------------------------------
# SMS (AFRICA'S TALKING)
# -----------------------------------------------------------------------------
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your-africastalking-api-key
AFRICASTALKING_SENDER_ID=ekub
AFRICASTALKING_COUNTRY=ETH

# -----------------------------------------------------------------------------
# PAYMENT GATEWAY - CHAPA (PRIMARY)
# -----------------------------------------------------------------------------
CHAPA_SECRET_KEY=your-chapa-secret-key
CHAPA_PUBLIC_KEY=your-chapa-public-key
CHAPA_WEBHOOK_SECRET=your-chapa-webhook-secret
CHAPA_API_URL=https://api.chapa.co/v1
CHAPA_TIMEOUT=30

# -----------------------------------------------------------------------------
# PAYMENT GATEWAY - TELEBIRR (OPTIONAL DIRECT INTEGRATION)
# -----------------------------------------------------------------------------
TELEBIRR_API_KEY=your-telebirr-api-key
TELEBIRR_SECRET=your-telebirr-secret
TELEBIRR_API_URL=https://api.telebirr.et/v1
TELEBIRR_MERCHANT_ID=your-merchant-id

# -----------------------------------------------------------------------------
# FRONTEND (CORS & CSRF)
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
FRONTEND_DEV_PORT=5173

# -----------------------------------------------------------------------------
# SECURITY & RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
OTP_EXPIRY_SECONDS=300
JWT_ACCESS_TOKEN_LIFETIME=3600
JWT_REFRESH_TOKEN_LIFETIME=604800
PASSWORD_RESET_TIMEOUT=3600

# -----------------------------------------------------------------------------
# PLATFORM FEES (percentage charged on each payout)
# -----------------------------------------------------------------------------
PLATFORM_FEE_PERCENTAGE=2.5
PLATFORM_FEE_MINIMUM=10.00
PLATFORM_FEE_MAXIMUM=500.00

# -----------------------------------------------------------------------------
# ADMIN SUPERUSER (used only for initial seeding)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@ekub-platform.com
ADMIN_PASSWORD=admin123

# -----------------------------------------------------------------------------
# LOGGING & MONITORING
# -----------------------------------------------------------------------------
SENTRY_DSN=
DJANGO_LOG_LEVEL=INFO
CELERY_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# FILE UPLOAD SETTINGS
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif

# -----------------------------------------------------------------------------
# DEFAULT GROUP SETTINGS
# -----------------------------------------------------------------------------
DEFAULT_CONTRIBUTION_AMOUNT=100.00
DEFAULT_CYCLE_LENGTH=10
DEFAULT_FREQUENCY=monthly

# -----------------------------------------------------------------------------
# DOCKER IMAGE TAGS
# -----------------------------------------------------------------------------
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest